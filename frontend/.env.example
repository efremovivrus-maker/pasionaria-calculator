NEXT_PUBLIC_N8N_WEBHOOK_URL=
NEXT_PUBLIC_BACKEND_URL=
# Server-only copy of the backend URL. The price-list proxy prefers this over the public URL.
BACKEND_URL=
# Shared by the Next.js server and the FastAPI service. Never expose it to the browser.
PRICE_LIST_TOKEN=
NEXT_PUBLIC_FEEDBACK_WEBHOOK_URL=https://pasionaria.app.n8n.cloud/webhook/calculator-feedback

# Keep both false until Supabase is configured and a production smoke test has passed.
ACCOUNT_ENABLED=false
NEXT_PUBLIC_ACCOUNT_ENABLED=false
NEXT_PUBLIC_SUPABASE_URL=
# Publishable key (sb_publishable_...) or the legacy anon JWT. This value is public.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Never prefix with NEXT_PUBLIC.
# Use the legacy service_role JWT (eyJ...) for creating users and resetting passwords.
# A secret key (sb_secret_...) is accepted by the same variable and bypasses RLS,
# but Auth Admin mutations can reject it. Keep the legacy service_role key until that succeeds.
SUPABASE_SERVICE_ROLE_KEY=

# Server-only. Do not prefix with NEXT_PUBLIC. Used by /api/proposal-message.
YANDEX_GPT_API_KEY=
YANDEX_GPT_FOLDER_ID=
